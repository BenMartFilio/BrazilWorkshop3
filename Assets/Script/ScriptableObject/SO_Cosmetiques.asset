    categorie: 0
  - identifiant: 2
    nomAffichage: Voiture bleu
    cleNom: 
    sprite: {fileID: 21300000, guid: b6a2fb549f2f6104e8b92b5a63524205, type: 3}
    description: "Malgr\xE9 son bleu semblable aux fonds marins, cette voiture ne
      peut pas nager."
    cleDescription: 
    categorie: 0
  - identifiant: 3
    nomAffichage: Brasier
    cleNom: 
    sprite: {fileID: 21300000, guid: 00c73c9de6cc3644cb20597725723778, type: 3}
    description: "Cette voiture br\xFBle comme la braise ! Tous les gens cools r\xEAvent
